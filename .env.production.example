# Copiar a .env.production y completar los valores reales (PSE-40).
# Generar SECRET_KEY:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# Dominios públicos (Caddy obtiene el certificado HTTPS automáticamente)
APP_DOMAIN=globalexchange.duckdns.org
AUTH_DOMAIN=auth.globalexchange.duckdns.org

# Django Production Settings
DEBUG=False
SECRET_KEY=your-super-secure-production-secret-key-change-this
ALLOWED_HOSTS=globalexchange.duckdns.org,localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=https://globalexchange.duckdns.org
USE_X_FORWARDED_PROTO=true

# Población inicial al iniciar el contenedor
SEED_DATA=true
SEED_TEST_USERS=true
KEYCLOAK_BOOTSTRAP=true

# Database Settings
DB_ENGINE=django.db.backends.postgresql
DB_NAME=globalexchange
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_HOST=db
DB_PORT=5432

# Keycloak Settings
# SERVER_URL: red interna de Docker (Django -> Keycloak). FRONTEND_URL: URL pública del navegador.
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_FRONTEND_URL=https://auth.globalexchange.duckdns.org
KEYCLOAK_REALM=global-exchange-realm
KEYCLOAK_CLIENT_ID=global-exchange-client
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret
KEYCLOAK_REDIRECT_URI=https://globalexchange.duckdns.org/auth/callback/

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_secure_keycloak_admin_password

# Integraciones
STRIPE_SECRET_KEY=
SIFEN_API_EMAIL=
SIFEN_API_PASSWORD=
SIFEN_API_BASE_URL=https://apitest.facturasegura.com.py
