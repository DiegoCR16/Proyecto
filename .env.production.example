# Django Production Settings
DEBUG=False
SECRET_KEY=your-super-secure-production-secret-key-change-this
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost

# Database Settings
DB_ENGINE=django.db.backends.postgresql
DB_NAME=globalexchange
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_HOST=db
DB_PORT=5432

# Keycloak Settings
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_FRONTEND_URL=https://auth.yourdomain.com
KEYCLOAK_REALM=global-exchange-realm
KEYCLOAK_CLIENT_ID=global-exchange-client
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret
KEYCLOAK_REDIRECT_URI=https://yourdomain.com/auth/callback/

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_secure_keycloak_admin_password
