# Plantilla de .env.production (PSE-40).
# deploy-remoto.sh la usa para generar .env.production en el servidor la primera vez
# (dominios, SECRET_KEY y contraseñas se completan solos). Después se edita en el servidor:
#   ssh ubuntu@<ip> nano globalexchange/.env.production

# Dominios públicos (Caddy obtiene el certificado HTTPS automáticamente)
APP_DOMAIN=globalexchange-g05.duckdns.org
AUTH_DOMAIN=auth.globalexchange-g05.duckdns.org

# Django Production Settings
DEBUG=False
SECRET_KEY=your-super-secure-production-secret-key-change-this
ALLOWED_HOSTS=globalexchange-g05.duckdns.org,localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=https://globalexchange-g05.duckdns.org
USE_X_FORWARDED_PROTO=true

# Población inicial al iniciar el contenedor
SEED_DATA=true
SEED_TEST_USERS=true
KEYCLOAK_BOOTSTRAP=true

# Recursos (servidor de 2 GB de RAM)
GUNICORN_WORKERS=2
KEYCLOAK_JAVA_OPTS=-Xms128m -Xmx512m

# Database Settings
DB_ENGINE=django.db.backends.postgresql
DB_NAME=globalexchange
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_HOST=db
DB_PORT=5432

# Keycloak Settings
# SERVER_URL: red interna de Docker (Django -> Keycloak). FRONTEND_URL: URL pública del navegador.
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_FRONTEND_URL=https://auth.globalexchange-g05.duckdns.org
KEYCLOAK_REALM=global-exchange-realm
KEYCLOAK_CLIENT_ID=global-exchange-client
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret
KEYCLOAK_REDIRECT_URI=https://globalexchange-g05.duckdns.org/auth/callback/

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_secure_keycloak_admin_password

# Correo real (Gmail con contraseña de aplicación). Lo usan Django y Keycloak.
# EMAIL_HOST vacío = correos por consola. Para activarlo: EMAIL_HOST=smtp.gmail.com,
# EMAIL_HOST_USER, EMAIL_HOST_PASSWORD y DEFAULT_FROM_EMAIL=Global Exchange <cuenta@gmail.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Integraciones
STRIPE_SECRET_KEY=
SIFEN_API_EMAIL=
SIFEN_API_PASSWORD=
SIFEN_API_BASE_URL=https://apitest.facturasegura.com.py
